# Salin file ini menjadi .env lalu isi API key kamu (dapat dari
# https://aistudio.google.com/apikey).
#
# Kalau GEMINI_API_KEY dikosongkan, ClipForge otomatis jalan pakai data
# mock — jadi project tetap bisa dicoba tanpa API key.

GEMINI_API_KEY=

# Opsional — ganti kalau mau pakai model Gemini lain.
GEMINI_MODEL=gemini-2.5-flash

# Port server backend
PORT=3000
